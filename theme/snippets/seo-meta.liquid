{%- liquid
  if template contains 'product' and product
    assign og_type = 'product'
    assign og_title = product.title | append: ' — ' | append: shop.name
    assign og_description = product.description | strip_html | truncatewords: 30
    if product.featured_media
      assign og_image = product.featured_media | image_url: width: 1200
    endif
  elsif template contains 'collection' and collection
    assign og_type = 'website'
    assign og_title = collection.title | append: ' — ' | append: shop.name
    assign og_description = collection.description | strip_html | truncatewords: 30
    if collection.image
      assign og_image = collection.image | image_url: width: 1200
    endif
  elsif template contains 'article' and article
    assign og_type = 'article'
    assign og_title = article.title | append: ' — ' | append: shop.name
    assign og_description = article.excerpt_or_content | strip_html | truncatewords: 30
    if article.image
      assign og_image = article.image | image_url: width: 1200
    endif
  else
    assign og_type = 'website'
    assign og_title = page_title
    assign og_description = page_description | default: shop.description
    if settings.social_share_image
      assign og_image = settings.social_share_image | image_url: width: 1200
    endif
  endif
-%}

<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:title" content="{{ og_title | escape }}">
{%- if og_description != blank -%}
  <meta property="og:description" content="{{ og_description | escape }}">
{%- endif -%}
{%- if og_image -%}
  <meta property="og:image" content="https:{{ og_image }}">
  <meta property="og:image:secure_url" content="https:{{ og_image }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
{%- endif -%}

<meta name="twitter:card" content="{% if og_image %}summary_large_image{% else %}summary{% endif %}">
<meta name="twitter:title" content="{{ og_title | escape }}">
{%- if og_description != blank -%}
  <meta name="twitter:description" content="{{ og_description | escape }}">
{%- endif -%}
{%- if og_image -%}
  <meta name="twitter:image" content="https:{{ og_image }}">
{%- endif -%}

{%- if template contains 'product' and product -%}
  <meta property="product:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
  <meta property="product:availability" content="{% if product.available %}in stock{% else %}out of stock{% endif %}">
{%- endif -%}
