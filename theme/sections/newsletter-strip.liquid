<section class="jm-newsletter">
  <div class="jm-container">
    <div class="jm-newsletter__inner">
      <div>
        <p class="jm-section__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        <h2>{{ section.settings.heading | escape }}</h2>
        <p>{{ section.settings.body | escape }}</p>
      </div>
      {%- form 'customer', class: 'jm-newsletter__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="email" name="contact[email]" required placeholder="{{ section.settings.placeholder | escape }}" aria-label="Email">
        <button type="submit">Subscribe →</button>
      {%- endform -%}
    </div>
  </div>
</section>

<style>
  .jm-newsletter { background: var(--paper); padding: 4rem 0; border-top: 1px solid var(--rule); }
  .jm-newsletter__inner {
    display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: center;
    max-width: 1080px; margin: 0 auto;
  }
  @media (max-width: 749px) { .jm-newsletter__inner { grid-template-columns: 1fr; gap: 1rem; } }
  .jm-newsletter h2 { letter-spacing: -0.03em; }
  .jm-newsletter p { font-size: 0.9375rem; color: var(--gray-500); max-width: 40ch; }
  .jm-newsletter__form {
    display: flex; gap: 0;
    border-bottom: 1.5px solid var(--ink);
    padding-bottom: 0.25rem;
  }
  .jm-newsletter__form input {
    flex: 1; padding: 0.625rem 0; border: 0; background: transparent;
    font-family: var(--sans); font-size: 0.9375rem;
    color: var(--ink); font-weight: 500;
  }
  .jm-newsletter__form input:focus { outline: none; }
  .jm-newsletter__form input::placeholder { color: var(--gray-300); }
  .jm-newsletter__form button {
    background: transparent; color: var(--ink); border: 0;
    padding: 0.625rem 0;
    font-family: var(--sans); font-size: 0.8125rem;
    font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
    cursor: pointer;
  }
  .jm-newsletter__form button:hover { color: var(--teal); }
</style>

{% schema %}
{
  "name": "Newsletter strip",
  "tag": "section",
  "class": "shopify-section-newsletter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Weekly · Free" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One thing, every Friday." },
    { "type": "textarea", "id": "body", "label": "Body",
      "default": "One pick a week — sun, surf, home, or travel — that we actually use. No tracking, no spam." },
    { "type": "text", "id": "placeholder", "label": "Input placeholder", "default": "your@email.com" }
  ],
  "presets": [{ "name": "Newsletter strip" }]
}
{% endschema %}
