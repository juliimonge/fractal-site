<section class="jm-section jm-cats-section">
  <div class="jm-container">
    <div class="jm-section__head">
      <div>
        <p class="jm-section__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        <h2>{{ section.settings.heading | escape }}</h2>
      </div>
    </div>

    <div class="jm-cats">
      {%- for block in section.blocks -%}
        <a class="jm-cat jm-cat--{{ block.settings.bg }}" href="{{ block.settings.link }}"
           {%- if block.settings.image != blank -%}
             style="background-image: url('{{ block.settings.image | image_url: width: 800 }}');"
           {%- elsif block.settings.asset != blank -%}
             style="background-image: url('{{ block.settings.asset | asset_url }}');"
           {%- endif -%}
           {{ block.shopify_attributes }}>
          <div class="jm-cat__label">
            {{ block.settings.title | escape }}<small>{{ block.settings.count | escape }}</small>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .jm-cats {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem;
  }
  @media (max-width: 749px) { .jm-cats { grid-template-columns: repeat(2, 1fr); } }
  .jm-cat {
    aspect-ratio: 4/3;
    background-size: 72% auto;
    background-position: center 45%;
    background-repeat: no-repeat;
    position: relative; overflow: hidden;
    color: var(--ink);
    display: flex; align-items: end;
    transition: transform 240ms cubic-bezier(0.2, 0.7, 0.3, 1);
    text-decoration: none;
  }
  .jm-cat:hover { transform: translateY(-3px); }
  .jm-cat--sand { background-color: #E8DFC8; }
  .jm-cat--cream { background-color: #F1EBD7; }
  .jm-cat--terracotta { background-color: #D9A088; color: #2A1410; }
  .jm-cat--jungle { background-color: #4C6A48; color: var(--white); }
  .jm-cat--ink { background-color: var(--ink); color: var(--white); }
  .jm-cat__label {
    position: relative; z-index: 2;
    padding: 1.25rem 1.5rem;
    display: flex; align-items: end; justify-content: space-between;
    width: 100%;
    font-weight: 700; font-size: 1rem;
  }
  .jm-cat__label small {
    font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.18em;
    text-transform: uppercase; opacity: 0.7;
  }
</style>

{% schema %}
{
  "name": "Category tiles",
  "tag": "section",
  "class": "shopify-section-cats",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop by category" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Apparel · Caps · Bags · Home." }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Apparel" },
        { "type": "text", "id": "count", "label": "Count caption", "default": "3 styles" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "image_picker", "id": "image", "label": "Image (overrides Asset)" },
        { "type": "text", "id": "asset", "label": "Asset filename",
          "info": "Theme asset filename (e.g. products/tee-sand.svg). Used if no image is picked.",
          "default": "tee-sand.svg" },
        { "type": "select", "id": "bg", "label": "Background tone",
          "options": [
            { "value": "sand", "label": "Sand" },
            { "value": "cream", "label": "Cream" },
            { "value": "terracotta", "label": "Terracotta" },
            { "value": "jungle", "label": "Jungle" },
            { "value": "ink", "label": "Ink" }
          ], "default": "sand"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category tiles",
      "blocks": [
        { "type": "tile", "settings": { "title": "Apparel", "count": "3 styles", "asset": "tee-sand.svg", "bg": "sand" } },
        { "type": "tile", "settings": { "title": "Caps", "count": "2 colors", "asset": "cap-teal.svg", "bg": "cream" } },
        { "type": "tile", "settings": { "title": "Bags", "count": "1 style", "asset": "tote.svg", "bg": "terracotta" } },
        { "type": "tile", "settings": { "title": "Home", "count": "2 items", "asset": "mug.svg", "bg": "jungle" } }
      ]
    }
  ]
}
{% endschema %}
