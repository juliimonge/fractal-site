<section class="jm-trust-section">
  <div class="jm-container">
    <div class="jm-trust">
      {%- for block in section.blocks -%}
        <div class="jm-trust__item" {{ block.shopify_attributes }}>
          <div class="jm-trust__icon">
            {%- case block.settings.icon -%}
              {%- when 'shield' -%}
                <svg viewBox="0 0 24 24"><path d="M12 2L4 6v6c0 5 3.5 9 8 10 4.5-1 8-5 8-10V6l-8-4z"/><path d="M9 12l2 2 4-4"/></svg>
              {%- when 'truck' -%}
                <svg viewBox="0 0 24 24"><rect x="2" y="7" width="14" height="10" rx="1"/><path d="M16 11h4l2 3v3h-6"/><circle cx="6" cy="18" r="2"/><circle cx="18" cy="18" r="2"/></svg>
              {%- when 'return' -%}
                <svg viewBox="0 0 24 24"><path d="M21 12a9 9 0 1 1-9-9"/><polyline points="14 4 21 4 21 11"/><line x1="21" y1="4" x2="12" y2="13"/></svg>
              {%- when 'leaf' -%}
                <svg viewBox="0 0 24 24"><path d="M12 2C8 8 5 13 12 22c7-9 4-14 0-20z"/></svg>
              {%- else -%}
                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/></svg>
            {%- endcase -%}
          </div>
          <div class="jm-trust__text">
            <strong>{{ block.settings.title | escape }}</strong>
            <span>{{ block.settings.subtitle | escape }}</span>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .jm-trust {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    padding: 2rem 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  @media (max-width: 899px) { .jm-trust { grid-template-columns: repeat(2, 1fr); gap: 1rem; } }
  @media (max-width: 549px) { .jm-trust { grid-template-columns: 1fr; } }
  .jm-trust__item { display: flex; align-items: center; gap: 0.875rem; }
  .jm-trust__icon { width: 36px; height: 36px; color: var(--teal); flex-shrink: 0; }
  .jm-trust__icon svg { width: 100%; height: 100%; stroke: currentColor; fill: none; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .jm-trust__text strong { display: block; font-size: 0.875rem; font-weight: 600; color: var(--ink); margin-bottom: 0.125rem; }
  .jm-trust__text span { font-size: 0.75rem; color: var(--gray-500); }
</style>

{% schema %}
{
  "name": "Trust strip",
  "tag": "section",
  "class": "shopify-section-trust",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "trust",
      "name": "Trust item",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon",
          "options": [
            { "value": "shield", "label": "Shield" },
            { "value": "truck", "label": "Truck" },
            { "value": "return", "label": "Return" },
            { "value": "leaf", "label": "Leaf" }
          ], "default": "shield"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Vetted by Julián" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Tested in Nosara before listed" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust strip",
      "blocks": [
        { "type": "trust", "settings": { "icon": "shield", "title": "Vetted by Julián", "subtitle": "Tested in Nosara before listed" } },
        { "type": "trust", "settings": { "icon": "truck", "title": "Ships fast", "subtitle": "Amazon Prime + Printful · Worldwide" } },
        { "type": "trust", "settings": { "icon": "return", "title": "Easy returns", "subtitle": "30 days, no-fuss policy" } },
        { "type": "trust", "settings": { "icon": "leaf", "title": "Reef-safe by default", "subtitle": "Curated for ocean & jungle" } }
      ]
    }
  ]
}
{% endschema %}
