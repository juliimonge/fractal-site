{%- liquid
  assign parent_url = section.settings.parent_site_url | default: settings.brand_parent_site_url | default: 'https://julianmonge.com'
  assign label = section.settings.label | default: 'Back to julianmonge.com'
-%}

<aside class="back-bar" role="complementary" aria-label="Site navigation">
  <div class="back-bar__inner page-width">
    <a class="back-bar__link" href="{{ parent_url }}" rel="noopener">
      <span class="back-bar__arrow" aria-hidden="true">&larr;</span>
      <span class="back-bar__label">{{ label }}</span>
    </a>
  </div>
</aside>

{% schema %}
{
  "name": "Back bar",
  "tag": "section",
  "class": "shopify-section-back-bar",
  "settings": [
    {
      "type": "header",
      "content": "Back to parent site"
    },
    {
      "type": "url",
      "id": "parent_site_url",
      "label": "Parent site URL",
      "info": "Defaults to brand setting (julianmonge.com)."
    },
    {
      "type": "text",
      "id": "label",
      "label": "Link label",
      "default": "Back to julianmonge.com"
    }
  ],
  "presets": [
    {
      "name": "Back bar"
    }
  ]
}
{% endschema %}
